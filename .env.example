# Never commit a real .env — copy this file to .env locally.
# Compose inlines DATABASE_URL / REDIS_URL / CORS_ORIGIN for the backend
# service; this file is the portfolio contract for local/non-Compose runs
# and for vars wired in later epics (JWT, OpenAI, cookies).

# Runtime
NODE_ENV=development
# Backend Express listen port. Frontend Next.js uses 3000 by default unless overridden.
PORT=4000

# Data stores (Compose DB user/password/db: apm / apm / apm)
DATABASE_URL=postgresql://apm:apm@localhost:5432/apm
REDIS_URL=redis://localhost:6379

# API / browser boundary
CORS_ORIGIN=http://localhost:3000
# Server-only Next.js rewrite target (not NEXT_PUBLIC_*). Local default if unset: http://localhost:4000
# Keep the port here aligned with backend PORT above.
API_URL=http://localhost:4000

# Auth (Epic 2 — loaded by backend env.ts)
# Minutes an email verification token stays valid before it must be resent (max 129600 = ~90 days).
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
# Minutes a password-reset token stays valid (max 1440 = 1 day).
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Minutes an organization invite token stays valid (default 10080 = 7 days; max 129600 = ~90 days).
ORG_INVITE_TOKEN_TTL_MINUTES=10080

# Outbound mail (EmailProvider). Independent of Mailpit: point SMTP_HOST at any SMTP server.
# Local Compose Mailpit: host `mailpit` (from the backend container) or `localhost` (from the host), port 1025.
# Leave SMTP_HOST empty to use the console fallback (tests).
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@localhost

# Auth (Epic 2 — loaded by backend env.ts).
# Local placeholders only. Production requires JWT_ACCESS_SECRET of at least 32 characters
# (not a change-me* placeholder) and COOKIE_SECURE=true (that is also the default when
# NODE_ENV=production and COOKIE_SECURE is unset).
# ACCESS_TOKEN_TTL_SECONDS max 3600 (~15m default). REFRESH_TOKEN_TTL_SECONDS max 2147483
# so cookie Max-Age cannot overflow a 32-bit millisecond field (~7d default).
JWT_ACCESS_SECRET=change-me-access
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false
# JWT_REFRESH_SECRET is intentionally not loaded; refresh tokens are opaque hashed rows, not JWTs.

# AI (Epic 9 — docs only; not loaded by backend env.ts yet)
# Unsafe placeholder — replace before any real use; not production-ready.
OPENAI_API_KEY=openai-api-key-placeholder
OPENAI_MODEL=gpt-4o-mini
